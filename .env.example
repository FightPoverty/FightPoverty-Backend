# Redis 連線設定
# 本地開發 (Local): 通常為 localhost, 6379, 密碼留空
# 部署 (Zeabur): 請參考 Zeabur 儀表板上 Redis 服務的「內部連線」或「外部連線」資訊
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS 前端網址設定
# 允許哪個前端網域可以跨機請求 (CORS) 這個後端 API，支援逗號分隔多個網域
# 本地開發 (Local): 通常為 http://localhost:5173
# 部署 (Zeabur): 填入你前端上線後的真實網址 (例如 https://fightpoverty.zeabur.app)
FRONTEND_URL=http://localhost:5173

# JWT 認證設定
# 部署 (Zeabur): 記得要在 Zeabur 變數設定裡，把 Secret Key 換成一段無法被猜透的亂碼
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# 安全與 Cookie 設定
# 是否啟用 Secure Cookie 與 SameSite=None。
# - 本地端開發 (HTTP) 請設為 false
# - 正式環境 (HTTPS，且前後端獨立子網域時)「必須」設為 true，否則登入 Cookie 會被瀏覽器阻擋
COOKIE_SECURE=false

# 前端專案部署補充說明
# 在部署「前端」專案 (Vite + React) 到 Zeabur 時，
# 請務必在前端服務的 Variables 區塊加入以下變數：
# VITE_API_URL=https://<你的後端網址>.zeabur.app/api
# VITE_PUBLIC_URL=https://<你的前端正式網址>.zeabur.app
# 以確保前端能順利發送請求給正確的後端 API 位置，以及 QR Code 能掃出正確連結。
